# Copy to .env and adjust. Used by docker compose and by apps run locally.

# PostgreSQL superuser / schema owner (runs migrations)
POSTGRES_USER=insights_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=customer_insights
# Non-owner role used by the API and analytics at runtime (subject to row-level security)
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-app

# Connection strings for running apps outside docker (host port 5432)
DATABASE_URL=postgresql://app_user:change-me-app@localhost:5432/customer_insights
DIRECT_DATABASE_URL=postgresql://insights_owner:change-me-owner@localhost:5432/customer_insights

# Shared secret between API and the internal analytics service
ANALYTICS_SERVICE_TOKEN=change-me-service-token
ANALYTICS_URL=http://localhost:8000

# Auth: HMAC key for access tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-48-chars-min
# Secure cookies need HTTPS; defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false
# Set when running behind a reverse proxy, e.g. TRUST_PROXY=1
TRUST_PROXY=false

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
