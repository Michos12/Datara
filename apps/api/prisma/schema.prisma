// Customer Insights database schema.
// Prisma owns every migration, including analytics tables (ADR-0005).
// Full target model: docs/03-data-model.md. Tables are added milestone by milestone.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// Connection URLs live outside the schema (Prisma 7): migrations use DIRECT_DATABASE_URL
// (schema owner) from prisma.config.ts; the app uses DATABASE_URL (app_user) through the
// pg driver adapter in src/infra/prisma.ts.
datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm]
}

// ───────────── Identity & tenancy ─────────────

enum Role {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

model Organization {
  id          String   @id @db.Uuid
  name        String
  slug        String   @unique
  /// IANA time zone name, e.g. "America/Bogota". All period bucketing uses it.
  timezone    String   @default("UTC")
  /// ISO-4217 currency code. One currency per organization.
  currency    String   @db.Char(3)
  /// retail | ecommerce | restaurant | subscription | services | other
  industry    String   @default("other")
  /// activeWindowDays, churnDays, weekStart, ... (see docs/05-analytics-methodology.md §4.4)
  settings    Json     @default("{}")
  /// Incremented on every tenant data change; analytics caches key on it.
  dataVersion BigInt   @default(0) @map("data_version")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   Membership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  customers     Customer[]
  orders        Order[]
  products      Product[]
  imports       Import[]

  @@map("organizations")
}

model User {
  id           String    @id @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Opaque, rotating refresh tokens (ADR-0007). Only a SHA-256 hash is stored. Every rotation
/// creates a new row in the same family; presenting a revoked token outside the grace window
/// revokes the whole family. Not RLS-protected: only the auth module reads it.
model RefreshToken {
  id             String       @id @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  /// The organization the session is active in; reissued access tokens keep it.
  organizationId String       @map("organization_id") @db.Uuid
  familyId       String       @map("family_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  replacedById   String?      @map("replaced_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Membership {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// ───────────── Customer data (M2) ─────────────
// Money is integer minor units of the organization's currency. Timestamps are UTC.

model Customer {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  /// ID in the tenant's source system; makes imports idempotent.
  externalId       String?   @map("external_id")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  email            String?   @db.Citext
  phone            String?
  /// ISO-3166 alpha-2
  country          String?   @db.Char(2)
  region           String?
  city             String?
  registeredAt     DateTime? @map("registered_at") @db.Date
  tags             String[]  @default([])
  attributes       Json      @default("{}")
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  anonymizedAt     DateTime? @map("anonymized_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([organizationId, externalId])
  @@index([organizationId, email])
  @@index([organizationId, createdAt])
  @@map("customers")
}

enum OrderStatus {
  PENDING
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

model Order {
  id             String      @id @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  /// Null for guest orders: they count toward revenue, not customer metrics.
  customerId     String?     @map("customer_id") @db.Uuid
  externalId     String?     @map("external_id")
  orderedAt      DateTime    @map("ordered_at") @db.Timestamptz(6)
  status         OrderStatus @default(COMPLETED)
  channel        String?
  grossCents     BigInt      @map("gross_cents")
  discountCents  BigInt      @default(0) @map("discount_cents")
  taxCents       BigInt      @default(0) @map("tax_cents")
  refundedCents  BigInt      @default(0) @map("refunded_cents")
  /// GENERATED ALWAYS AS (gross - discount - refunded) STORED, tax excluded (decision OPEN-3).
  /// Read-only: defined in raw SQL in the migration.
  netCents       BigInt      @default(dbgenerated()) @map("net_cents")
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@unique([organizationId, externalId])
  @@index([organizationId, orderedAt])
  @@index([organizationId, customerId, orderedAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  sku            String?
  name           String
  quantity       Int
  unitPriceCents BigInt   @map("unit_price_cents")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId, orderId])
  @@index([organizationId, productId])
  @@map("order_items")
}

model Product {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  externalId     String?      @map("external_id")
  name           String
  category       String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          OrderItem[]

  @@unique([organizationId, externalId])
  @@map("products")
}

enum ImportEntity {
  CUSTOMERS
  ORDERS
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
}

/// A CSV import: upload → map columns → validate (background) → commit (background).
model Import {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  entity         ImportEntity
  status         ImportStatus @default(UPLOADED)
  fileKey        String       @map("file_key")
  originalName   String       @map("original_name")
  sizeBytes      Int          @map("size_bytes")
  /// { columns, mapping, options } once mapped
  mapping        Json?
  rowsTotal      Int          @default(0) @map("rows_total")
  rowsValid      Int          @default(0) @map("rows_valid")
  rowsFailed     Int          @default(0) @map("rows_failed")
  rowsInserted   Int          @default(0) @map("rows_inserted")
  rowsUpdated    Int          @default(0) @map("rows_updated")
  /// First errors for display; the full list is in the error file.
  errorSample    Json         @default("[]") @map("error_sample")
  errorFileKey   String?      @map("error_file_key")
  failureReason  String?      @map("failure_reason")
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt     DateTime?    @map("finished_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("imports")
}

// ───────────── Operations ─────────────

/// Append-only audit trail of security-relevant and data-changing actions (PLT-01).
/// Never contains passwords, tokens or customer personal data.
model AuditLog {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  /// e.g. "auth.signup", "auth.login", "auth.refresh_reuse", "organization.update"
  action         String
  entityType     String?      @map("entity_type")
  entityId       String?      @map("entity_id") @db.Uuid
  details        Json         @default("{}")
  ip             String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Postgres-backed job queue (ADR-0003). Node claims import./export./report. jobs,
/// the analytics worker claims analytics. jobs. Not RLS-protected: handlers set app.org_id
/// from the job before touching tenant data.
model Job {
  id             String    @id @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  type           String
  payload        Json      @default("{}")
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  runAfter       DateTime  @default(now()) @map("run_after") @db.Timestamptz(6)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([status, runAfter])
  @@index([organizationId, createdAt])
  @@map("jobs")
}
